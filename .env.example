# URL publique du service (sert aussi à construire l'URI de redirection OAuth)
BASE_URL=https://rdv.exemple.com
PORT=3000

# Mot de passe de /admin (connexion des comptes Google, tests). Vide = /admin désactivé.
ADMIN_PASSWORD=change-moi

# Clé de signature des sessions des pages protégées par mot de passe.
# Générer avec : openssl rand -hex 32  (vide = visiteurs déconnectés à chaque redémarrage)
SESSION_SECRET=

# Mots de passe des pages, référencés dans config.yaml via ${...}
# DEMO_EQUIPE_PASSWORD=

# Derrière un reverse proxy (Traefik, Nginx, Caddy…) : true pour avoir la vraie IP client
TRUST_PROXY=true

# --- Option A : OAuth (Gmail ou Workspace) -----------------------------------
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- Option B : Workspace avec compte de service + délégation domaine --------
# (si défini, remplace l'option A)
# GOOGLE_SERVICE_ACCOUNT_FILE=/run/secrets/google-sa.json
# GOOGLE_SERVICE_ACCOUNT_JSON={"type":"service_account",...}

# --- Réglages ----------------------------------------------------------------
# FREEBUSY_CACHE_SECONDS=60
# BOOKING_RATE_LIMIT=5
# BOOKING_RATE_WINDOW_MINUTES=15
# DEMO_MODE=false   # true = aucun appel Google, disponibilités simulées
